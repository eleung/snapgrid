{
  "name": "snapgrid-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev": "pnpm --filter @snapgridjs/docs dev",
    "e2e": "pnpm --filter @snapgridjs/docs e2e",
    "search:sync": "pnpm --filter @snapgridjs/docs search:sync",
    "assets": "pnpm --filter @snapgridjs/docs assets",
    "check:og": "pnpm --filter @snapgridjs/docs check:og",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm size",
    "size": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write packages/*/package.json && pnpm --filter @snapgridjs/docs cards",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "^14.3.0",
    "@solidjs/testing-library": "^0.8.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "^5.2.6",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^14.3.0",
    "solid-js": "^1.9.17",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "vue": "^3.5.0"
  }
}
